{
    "name": "genaker/agento-mcp",
    "description": "AI-powered development tools for Magento - MCP server integration, SQL queries, cache management, and n98-magerun2 integration",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "mcp",
        "model-context-protocol",
        "ai",
        "cursor",
        "magerun",
        "development-tools"
    ],
    "authors": [
        {
            "name": "Genaker",
            "homepage": "https://github.com/Genaker"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": "^103.0|^104.0",
        "php-mcp/server": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Agento\\Core\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "map": [
            [
                "*",
                "Agento/Core"
            ]
        ]
    }
}

