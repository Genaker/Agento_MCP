{
    "name": "agento/core",
    "description": "AI-powered development tools for Magento - MCP server integration, SQL queries, cache management, and n98-magerun2 integration",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Agento",
            "email": "dev@agento.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "php-mcp/server": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Agento\\Core\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "map": [
            [
                "*",
                "Agento/Core"
            ]
        ]
    }
}

